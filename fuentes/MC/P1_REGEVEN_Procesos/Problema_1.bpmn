    <bpmn:sequenceFlow id="F16" name="No" sourceRef="G_xs2" targetRef="G_xm2"/>
    <bpmn:sequenceFlow id="F17" name="" sourceRef="T_g" targetRef="G_xm2"/>
    <bpmn:sequenceFlow id="F18" name="" sourceRef="G_xm2" targetRef="T_h"/>
    <bpmn:sequenceFlow id="F19" name="" sourceRef="T_h" targetRef="T_i"/>
    <bpmn:sequenceFlow id="F20" name="" sourceRef="T_i" targetRef="T_j"/>
    <bpmn:sequenceFlow id="F21" name="" sourceRef="T_j" targetRef="Fin"/>
  </bpmn:process>
