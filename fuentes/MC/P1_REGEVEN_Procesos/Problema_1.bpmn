<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definiciones_R05" targetNamespace="http://fime.uanl.mx/tsci3/p1">
  <bpmn:collaboration id="Colaboracion">
    <bpmn:participant id="Pool" name="Trámite de autorización (Registro 05)" processRef="Proceso_R05"/>
  </bpmn:collaboration>
  <bpmn:process id="Proceso_R05" isExecutable="false">
    <bpmn:laneSet id="Carriles">
      <bpmn:lane id="L1" name="Recepción (Nora, Luis, Ana)">
        <bpmn:flowNodeRef>Inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_a</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_d</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L2" name="Validación de identidad (Julia, Raúl)">
        <bpmn:flowNodeRef>G_and1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_b</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L3" name="Revisión documental y agenda (Elena, Marco, Pilar)">
        <bpmn:flowNodeRef>T_c</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_and2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_xm1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_xs1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_c2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L4" name="Entrevista (Celia, Óscar)">
        <bpmn:flowNodeRef>T_f</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_xs2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_g</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_xm2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L5" name="Integración y cierre (Marta, Iván)">
        <bpmn:flowNodeRef>T_h</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_j</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Fin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L6" name="Autorización (Sofía)">
        <bpmn:flowNodeRef>T_i</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Inicio" name="Solicitud entrante">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="T_a" name="Solicitud recibida">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="G_and1" name="">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="T_b" name="Identidad validada">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_c" name="Documentos verificados">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="G_and2" name="">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="G_xm1" name="">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="G_xs1" name="¿Documentación correcta?">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_d" name="Corrección solicitada">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_c2" name="Documentos verificados (re-verificación)">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_e" name="Cita programada">
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_f" name="Entrevista realizada">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G_xs2" name="¿Requiere orientación?">
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_g" name="Orientación brindada">
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G_xm2" name="">
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:incoming>F17</bpmn:incoming>
      <bpmn:outgoing>F18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_h" name="Expediente integrado">
      <bpmn:incoming>F18</bpmn:incoming>
      <bpmn:outgoing>F19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_i" name="Autorización emitida">
      <bpmn:incoming>F19</bpmn:incoming>
      <bpmn:outgoing>F20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_j" name="Cierre registrado">
      <bpmn:incoming>F20</bpmn:incoming>
      <bpmn:outgoing>F21</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Fin" name="Trámite concluido">
      <bpmn:incoming>F21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" name="" sourceRef="Inicio" targetRef="T_a"/>
    <bpmn:sequenceFlow id="F2" name="" sourceRef="T_a" targetRef="G_and1"/>
