digraph RedPetri {
  rankdir=LR; splines=true; nodesep=0.35; ranksep=0.32; pad=0.2;
  node [fontname="Helvetica", fontsize=10]; edge [arrowsize=0.7];
  labelloc="t"; fontname="Helvetica-Bold"; fontsize=14;
  labelloc="b"; label=<<b>Red de Petri (red WF) - Registro 05</b><br/><font face="Helvetica" point-size="12">a = solicitud recibida &#183; b = identidad validada &#183; c = documentos verificados &#183; d = corrección solicitada &#183; e = cita programada<br/>f = entrevista realizada &#183; g = orientación brindada &#183; h = expediente integrado &#183; i = autorización emitida &#183; j = cierre registrado<br/>c' = documentos verificados (re-verificación) &#183; &#964; = transición silenciosa</font>>;
  "ini" [shape=circle, width=0.42, fixedsize=true, label="&#9679;", xlabel=<<font point-size="9">ini</font>>];
  "p1" [shape=circle, width=0.42, fixedsize=true, label="", xlabel=<<font point-size="9">p1</font>>];
  "p2" [shape=circle, width=0.42, fixedsize=true, label="", xlabel=<<font point-size="9">p2</font>>];
  "p3" [shape=circle, width=0.42, fixedsize=true, label="", xlabel=<<font point-size="9">p3</font>>];
  "p4" [shape=circle, width=0.42, fixedsize=true, label="", xlabel=<<font point-size="9">p4</font>>];
  "p5" [shape=circle, width=0.42, fixedsize=true, label="", xlabel=<<font point-size="9">p5</font>>];
  "p6" [shape=circle, width=0.42, fixedsize=true, label="", xlabel=<<font point-size="9">p6</font>>];
  "p7" [shape=circle, width=0.42, fixedsize=true, label="", xlabel=<<font point-size="9">p7</font>>];
  "p8" [shape=circle, width=0.42, fixedsize=true, label="", xlabel=<<font point-size="9">p8</font>>];
  "p9" [shape=circle, width=0.42, fixedsize=true, label="", xlabel=<<font point-size="9">p9</font>>];
  "p10" [shape=circle, width=0.42, fixedsize=true, label="", xlabel=<<font point-size="9">p10</font>>];
  "p11" [shape=circle, width=0.42, fixedsize=true, label="", xlabel=<<font point-size="9">p11</font>>];
  "fin" [shape=circle, width=0.42, fixedsize=true, label="", xlabel=<<font point-size="9">fin</font>> peripheries=2];
  "a" [shape=box, width=0.5, height=0.5, fixedsize=true, style="filled", fillcolor="#EAF2FB", color="#2F5D8A", fontsize=16, label=<<b>a</b>>];
  "b" [shape=box, width=0.5, height=0.5, fixedsize=true, style="filled", fillcolor="#EAF2FB", color="#2F5D8A", fontsize=16, label=<<b>b</b>>];
  "c" [shape=box, width=0.5, height=0.5, fixedsize=true, style="filled", fillcolor="#EAF2FB", color="#2F5D8A", fontsize=16, label=<<b>c</b>>];
  "t1" [shape=box, style=filled, fillcolor=black, width=0.14, height=0.55, fixedsize=true, label="", xlabel=<<font point-size="9">&#964;1</font>>];
  "d" [shape=box, width=0.5, height=0.5, fixedsize=true, style="filled", fillcolor="#EAF2FB", color="#2F5D8A", fontsize=16, label=<<b>d</b>>];
  "c2" [shape=box, width=0.5, height=0.5, fixedsize=true, style="filled", fillcolor="#EAF2FB", color="#2F5D8A", fontsize=16, label=<<b>c'</b>>];
  "e" [shape=box, width=0.5, height=0.5, fixedsize=true, style="filled", fillcolor="#EAF2FB", color="#2F5D8A", fontsize=16, label=<<b>e</b>>];
  "f" [shape=box, width=0.5, height=0.5, fixedsize=true, style="filled", fillcolor="#EAF2FB", color="#2F5D8A", fontsize=16, label=<<b>f</b>>];
  "g" [shape=box, width=0.5, height=0.5, fixedsize=true, style="filled", fillcolor="#EAF2FB", color="#2F5D8A", fontsize=16, label=<<b>g</b>>];
  "t2" [shape=box, style=filled, fillcolor=black, width=0.14, height=0.55, fixedsize=true, label="", xlabel=<<font point-size="9">&#964;2</font>>];
  "h" [shape=box, width=0.5, height=0.5, fixedsize=true, style="filled", fillcolor="#EAF2FB", color="#2F5D8A", fontsize=16, label=<<b>h</b>>];
  "i" [shape=box, width=0.5, height=0.5, fixedsize=true, style="filled", fillcolor="#EAF2FB", color="#2F5D8A", fontsize=16, label=<<b>i</b>>];
  "j" [shape=box, width=0.5, height=0.5, fixedsize=true, style="filled", fillcolor="#EAF2FB", color="#2F5D8A", fontsize=16, label=<<b>j</b>>];
  "ini" -> "a";
  "a" -> "p1";
  "a" -> "p2";
  "p1" -> "b";
  "b" -> "p3";
  "p2" -> "c";
  "c" -> "p4";
  "p3" -> "t1";
  "p4" -> "t1";
  "t1" -> "p5";
  "p5" -> "d" [color="#B04A2F"];
  "d" -> "p6" [color="#B04A2F"];
  "p6" -> "c2" [color="#B04A2F"];
  "c2" -> "p5" [color="#B04A2F"];
  "p5" -> "e";
  "e" -> "p7";
  "p7" -> "f";
  "f" -> "p8";
  "p8" -> "g";
  "g" -> "p9";
  "p8" -> "t2";
  "t2" -> "p9";
  "p9" -> "h";
  "h" -> "p10";
  "p10" -> "i";
  "i" -> "p11";
  "p11" -> "j";
  "j" -> "fin";
  { rank=same; "p1"; "p2"; }
  { rank=same; "b"; "c"; }
  { rank=same; "p3"; "p4"; }
}
