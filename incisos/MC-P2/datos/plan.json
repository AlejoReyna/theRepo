{
 "problema": "MC AD26 problema 2: tratamiento de export.csv con subsettings variados",
 "objetivo": "Clasificar el nivel de obesidad adulta (Baja < 30 %, Media 30-35 %, Alta >= 35 %) de cada estado x año con sus indicadores de actividad física (Q043-Q047)",
 "archivo": "export.csv",
 "na": ["", "NA"],
 "recortar_nombres": true,
 "pasos": [
  {"tipo": "perfil"},
  {"id": "P1", "tipo": "quitar_columnas", "operacion": "Eliminar columnas constantes, duplicadas, dispersas y códigos",
   "columnas": ["YearEnd", "Datasource", "Topic", "Question", "Data_Value_Unit", "Data_Value_Type", "Data_Value_Alt",
                "Data_Value_Footnote", "Total", "Age(years)", "Education", "Sex", "Income", "Race/Ethnicity", "ClassID",
                "TopicID", "DataValueTypeID", "LocationID", "StratificationCategoryId1", "StratificationID1"]},
  {"id": "P2a", "tipo": "numero", "operacion": "Sample_Size: texto con comas -> número", "columna": "Sample_Size", "quitar": ","},
  {"id": "P2b", "tipo": "extraer", "operacion": "GeoLocation -> Latitud y Longitud", "columna": "GeoLocation",
   "regex": "\\(\\s*([-0-9.]+),\\s*([-0-9.]+)\\)", "nuevas": ["Latitud", "Longitud"], "quitar_origen": true},
  {"id": "P2c", "tipo": "restar", "operacion": "Ancho_IC = High - Low", "nueva": "Ancho_IC", "a": "High_Confidence_Limit", "b": "Low_Confidence_Limit"},
  {"id": "P2", "tipo": "renombrar", "operacion": "YearStart -> Anio", "nombres": {"YearStart": "Anio"}},
  {"id": "P3a", "tipo": "filtrar", "operacion": "Quitar filas sin valor (suprimidas por muestra insuficiente)", "condicion": ["Data_Value", "no_na"]},
  {"id": "P3", "tipo": "quitar_columnas", "operacion": "Quitar el símbolo de supresión (ya constante)", "columnas": ["Data_Value_Footnote_Symbol"]},
  {"id": "P4", "tipo": "filtrar", "operacion": "Solo 50 estados + DC", "condicion": ["LocationAbbr", "no_en", ["US", "GU", "PR", "VI"]], "estilo": "corchetes"},
  {"id": "P5", "tipo": "excluir", "operacion": "Quitar estimaciones imprecisas (IC > 20)", "condicion": ["Ancho_IC", ">", 20]},
  {"id": "P6", "tipo": "filtrar", "operacion": "Estrato Total (nivel estatal)", "condicion": ["StratificationCategory1", "==", "Total"], "estilo": "corchetes"},
  {"id": "P7", "tipo": "filtrar", "operacion": "Obesidad (Q036) y actividad física (Q043-Q047)",
   "condicion": {"y": [["Class", "contiene", "Obesity|Physical Activity"], ["QuestionID", "!=", "Q037"]]}, "estilo": "corchetes"},
  {"id": "P8", "tipo": "comunes", "operacion": "Años con todas las preguntas", "columna": "Anio", "grupo": "QuestionID"},
  {"id": "P9", "tipo": "pivotear", "operacion": "Pivoteo largo -> ancho (reshape)", "claves": ["LocationAbbr", "LocationDesc", "Anio"], "columna": "QuestionID", "valor": "Data_Value"},
  {"id": "P10", "tipo": "completos", "operacion": "Eliminar estado-año incompletos", "guardar": "vista_minable.csv"},
  {"id": "P11", "tipo": "filtrar", "operacion": "Obesidad 2025, todos los estratos", "desde": "P5",
   "condicion": {"y": [["QuestionID", "==", "Q036"], ["Anio", "==", 2025]]},
   "select": ["LocationAbbr", "StratificationCategory1", "Stratification1", "Data_Value", "Sample_Size"]},
  {"id": "P10c", "tipo": "discretizar", "operacion": "Clase nivel_obesidad con cut()", "desde": "P10",
   "columna": "Data_Value.Q036", "cortes": [null, 30, 35, null], "etiquetas": ["Baja", "Media", "Alta"], "nueva": "nivel_obesidad"},
  {"id": "P12", "tipo": "muestra", "operacion": "Muestra de entrenamiento (70 %)", "desde": "P10c", "proporcion": 0.7, "semilla": 1851265},
  {"id": "P13", "tipo": "muestra", "operacion": "Muestra de prueba (30 %)", "desde": "P10c", "proporcion": 0.7, "semilla": 1851265, "parte": "resto"}
 ]
}
