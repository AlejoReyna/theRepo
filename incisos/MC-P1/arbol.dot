digraph arbol {
  node [fontname="Helvetica"];
  n1 [shape=circle, label="→"];
  n2 [shape=box, label=<<b>a</b><br/><font point-size="9">solicitud recibida</font>>];
  n1 -> n2;
  n3 [shape=circle, label="∧"];
  n4 [shape=box, label=<<b>b</b><br/><font point-size="9">identidad validada</font>>];
  n3 -> n4;
  n5 [shape=box, label=<<b>c</b><br/><font point-size="9">documentos verificados</font>>];
  n3 -> n5;
  n1 -> n3;
  n6 [shape=circle, label="⟲"];
  n7 [shape=box, style=filled, fillcolor=black, fontcolor=white, label="τ"];
  n6 -> n7;
  n8 [shape=circle, label="→"];
  n9 [shape=box, label=<<b>d</b><br/><font point-size="9">corrección solicitada</font>>];
  n8 -> n9;
  n10 [shape=box, label=<<b>c</b><br/><font point-size="9">documentos verificados</font>>];
  n8 -> n10;
  n6 -> n8;
  n1 -> n6;
  n11 [shape=box, label=<<b>e</b><br/><font point-size="9">cita programada</font>>];
  n1 -> n11;
  n12 [shape=box, label=<<b>f</b><br/><font point-size="9">entrevista realizada</font>>];
  n1 -> n12;
  n13 [shape=circle, label="×"];
  n14 [shape=box, style=filled, fillcolor=black, fontcolor=white, label="τ"];
  n13 -> n14;
  n15 [shape=box, label=<<b>g</b><br/><font point-size="9">orientación brindada</font>>];
  n13 -> n15;
  n1 -> n13;
  n16 [shape=box, label=<<b>h</b><br/><font point-size="9">expediente integrado</font>>];
  n1 -> n16;
  n17 [shape=box, label=<<b>i</b><br/><font point-size="9">autorización emitida</font>>];
  n1 -> n17;
  n18 [shape=box, label=<<b>j</b><br/><font point-size="9">cierre registrado</font>>];
  n1 -> n18;
}
