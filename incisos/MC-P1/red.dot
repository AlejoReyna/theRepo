  "p2" -> "c";
  "c" -> "p4";
  "τ1" [shape=box, style=filled, fillcolor=black, width=0.12, height=0.5, fixedsize=true, label="", xlabel="τ1"];
  "p3" -> "τ1";
  "p4" -> "τ1";
  "τ1" -> "p5";
